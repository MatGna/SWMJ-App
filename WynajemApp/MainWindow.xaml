<Window x:Class="WynajemApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Wynajmu Miejskich Jednosladow"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pasek tytulowy -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Margin="20,0,0,0" Padding="10,4">
                        <TextBlock Text="🚲" FontSize="22" />
                    </Border>
                    <TextBlock Text="System Wynajmu Miejskich Jednosladow" Style="{StaticResource HeaderTextStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Projekt BD2 - Etap aplikacji"
                           Foreground="{StaticResource TextLightBrush}"
                           VerticalAlignment="Center" Margin="0,0,20,0" FontStyle="Italic" />
            </Grid>
        </Border>

        <!-- Zawartosc - zakladki -->
        <TabControl Grid.Row="1" Margin="20" Background="Transparent" BorderThickness="0">
            <TabItem Header="Uzytkownicy">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Lista uzytkownikow" Style="{StaticResource SectionTitleStyle}" />
                        <Button Content="+ Dodaj" Style="{StaticResource AccentButtonStyle}" Margin="20,0,0,12" Click="NotImplemented_Click" />
                        <Button Content="Edytuj" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12" Click="NotImplemented_Click" />
                        <Button Content="Usun"   Style="{StaticResource DangerButtonStyle}"  Margin="0,0,0,12" Click="NotImplemented_Click" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="GridUzytkownicy">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"        Binding="{Binding IdUzytkownika}" Width="60" />
                            <DataGridTextColumn Header="Imie"      Binding="{Binding Imie}"          Width="*"  />
                            <DataGridTextColumn Header="Nazwisko"  Binding="{Binding Nazwisko}"      Width="*"  />
                            <DataGridTextColumn Header="Email"     Binding="{Binding Email}"         Width="2*" />
                            <DataGridTextColumn Header="Telefon"   Binding="{Binding Telefon}"       Width="*"  />
                            <DataGridTextColumn Header="Saldo (PLN)" Binding="{Binding Saldo, StringFormat=F2}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Pojazdy">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Flota pojazdow" Style="{StaticResource SectionTitleStyle}" />
                        <Button Content="+ Dodaj"      Style="{StaticResource AccentButtonStyle}"  Margin="20,0,0,12" Click="NotImplemented_Click" />
                        <Button Content="Zmien status" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12"  Click="NotImplemented_Click" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="GridPojazdy">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"              Binding="{Binding IdPojazdu}"      Width="60" />
                            <DataGridTextColumn Header="Typ"             Binding="{Binding Typ}"            Width="*"  />
                            <DataGridTextColumn Header="Numer seryjny"   Binding="{Binding NumerSeryjny}"   Width="*"  />
                            <DataGridTextColumn Header="Status"          Binding="{Binding Status}"         Width="*"  />
                            <DataGridTextColumn Header="Stan techniczny" Binding="{Binding StanTechniczny}" Width="*"  />
                            <DataGridTextColumn Header="ID stacji"       Binding="{Binding IdStacji}"       Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Stacje">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Stacje dokujace" Style="{StaticResource SectionTitleStyle}" />
                        <Button Content="+ Dodaj" Style="{StaticResource AccentButtonStyle}" Margin="20,0,0,12" Click="NotImplemented_Click" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="GridStacje">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"        Binding="{Binding IdStacji}"  Width="60" />
                            <DataGridTextColumn Header="Nazwa"     Binding="{Binding Nazwa}"     Width="*"  />
                            <DataGridTextColumn Header="Adres"     Binding="{Binding Adres}"     Width="2*" />
                            <DataGridTextColumn Header="Pojemnosc" Binding="{Binding Pojemnosc}" Width="*"  />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Wypozyczenia">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Historia wypozyczen" Style="{StaticResource SectionTitleStyle}" />
                        <Button Content="+ Nowe wypozyczenie" Style="{StaticResource AccentButtonStyle}" Margin="20,0,0,12" Click="NotImplemented_Click" />
                        <Button Content="Zakoncz"             Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12"  Click="NotImplemented_Click" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="GridWypozyczenia">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"           Binding="{Binding IdWypozyczenia}"   Width="60" />
                            <DataGridTextColumn Header="Start"        Binding="{Binding DataRozpoczecia, StringFormat=g}" Width="*"  />
                            <DataGridTextColumn Header="Koniec"       Binding="{Binding DataZakonczenia, StringFormat=g}" Width="*"  />
                            <DataGridTextColumn Header="Oplata"       Binding="{Binding Oplata, StringFormat=F2}"         Width="*"  />
                            <DataGridTextColumn Header="ID uzytk."    Binding="{Binding IdUzytkownika}"     Width="80" />
                            <DataGridTextColumn Header="ID pojazdu"   Binding="{Binding IdPojazdu}"         Width="80" />
                            <DataGridTextColumn Header="ID cennika"   Binding="{Binding IdCennika}"         Width="80" />
                            <DataGridTextColumn Header="Stacja start" Binding="{Binding IdStacjiStartowej}" Width="80" />
                            <DataGridTextColumn Header="Stacja koniec" Binding="{Binding IdStacjiKoncowej}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Cennik">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Cennik" Style="{StaticResource SectionTitleStyle}" />
                        <Button Content="+ Nowa stawka" Style="{StaticResource AccentButtonStyle}" Margin="20,0,0,12" Click="NotImplemented_Click" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="GridCennik">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"               Binding="{Binding IdCennika}"      Width="60" />
                            <DataGridTextColumn Header="Typ pojazdu"      Binding="{Binding TypPojazdu}"     Width="*"  />
                            <DataGridTextColumn Header="Stawka / minute" Binding="{Binding StawkaZaMinute, StringFormat=F2}" Width="*" />
                            <DataGridTextColumn Header="Data od"          Binding="{Binding DataOd, StringFormat=d}" Width="*" />
                            <DataGridTextColumn Header="Data do"          Binding="{Binding DataDo, StringFormat=d}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Doladowania">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Doladowania kont" Style="{StaticResource SectionTitleStyle}" />
                        <Button Content="+ Nowe doladowanie" Style="{StaticResource AccentButtonStyle}" Margin="20,0,0,12" Click="NotImplemented_Click" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="GridDoladowania">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"         Binding="{Binding IdDoladowania}" Width="60" />
                            <DataGridTextColumn Header="Kwota"      Binding="{Binding Kwota, StringFormat=F2}" Width="*" />
                            <DataGridTextColumn Header="Data"       Binding="{Binding Data, StringFormat=g}"   Width="*" />
                            <DataGridTextColumn Header="ID uzytk."  Binding="{Binding IdUzytkownika}"          Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Pasek statusu -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryBrush}" Height="28">
            <TextBlock x:Name="StatusText" Text="Gotowy" Foreground="{StaticResource TextLightBrush}"
                       VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12" />
        </Border>
    </Grid>
</Window>
